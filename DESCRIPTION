Package: sparqlr
Title: A SPARQL Client for R
Version: 0.1.0
Authors@R: c(
    person("Marco", "Pagni", , "marco.pagni@sib.swiss", role = "aut",
           comment = c(ORCID = "0000-0001-9292-9463")),
